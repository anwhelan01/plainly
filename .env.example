# Local checker and skill export work with every value below unset.
# Build-time flag: controls visibility of the optional Rewrite button.
VITE_PLAINLY_REWRITE_ENABLED=false
# Runtime opt-in. Requires all remaining settings before any provider call.
PLAINLY_REWRITE_ENABLED=false
XAI_API_KEY=
# Set an exact model ID available to your xAI account; no guessed default.
XAI_MODEL=
# Persistent LOCAL volume, shared by all workers. Do not use ephemeral/serverless storage.
PLAINLY_DATA_DIR=/var/lib/plainly
PLAINLY_DAILY_REWRITES=50
# Exact browser origin, e.g. https://your-real-domain (no trailing slash).
PLAINLY_ORIGIN=
NITRO_HOST=127.0.0.1
NITRO_PORT=8085
